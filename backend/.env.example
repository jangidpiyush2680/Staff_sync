# Copy this file to .env and fill in your own values. Do not commit .env.
PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/staffsync?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
JWT_EXPIRES_IN=8h
CLIENT_URL=http://localhost:5173
APP_TIME_ZONE=Asia/Kolkata
# Optional: used only when you intentionally run npm run seed. Blank uses the documented local demo password.
SEED_PASSWORD=
SEED_HR_EMAIL=hr@staffsync.local
SEED_MANAGER_EMAIL=manager@staffsync.local
